+    // Jannatuk (D47): whisperReadHeld(contextId, texts, options, audio) reads the audio again,
+    // once per text, held to it (native/quran-decoding); resolves with the readings as JSON.
+    auto readHeld = jsi::Function::createFromHostFunction(
+        runtime,
+        jsi::PropNameID::forAscii(runtime, "whisperReadHeld"),
+        4,
+        [callInvoker](
+            jsi::Runtime &runtime,
+            const jsi::Value &,
+            const jsi::Value *arguments,
+            size_t count) -> jsi::Value {
+            int contextId = requireContextId(runtime, arguments, count);
+            if (count < 2 || !arguments[1].isObject() ||
+                !arguments[1].asObject(runtime).isArray(runtime)) {
+                throw jsi::JSError(runtime, "Held texts must be an array of strings");
+            }
+            auto textArray = arguments[1].asObject(runtime).asArray(runtime);
+            std::vector<std::string> texts;
+            for (size_t i = 0; i < textArray.size(runtime); ++i) {
+                auto value = textArray.getValueAtIndex(runtime, i);
+                if (!value.isString()) {
+                    throw jsi::JSError(runtime, "Held texts must be an array of strings");
+                }
+                texts.push_back(value.asString(runtime).utf8(runtime));
+            }
+            auto options = requireObjectArgument(
+                runtime, arguments, count, 2, "Held reading options must be an object");
+            auto audio = requireAudioBufferArgument(runtime, arguments, count, 3);
+
+            quran_decoding::ReadOptions readOptions;
+            int maxThreads = static_cast<int>(std::thread::hardware_concurrency());
+            int defaultThreads = maxThreads == 4 ? 2 : std::min(4, maxThreads);
+            int nThreads = getIntProperty(runtime, options, "maxThreads", defaultThreads);
+            readOptions.threads = nThreads > 0 ? nThreads : defaultThreads;
+            readOptions.min_letters = getIntProperty(runtime, options, "minLetters", 0);
+            readOptions.free_letter_cost = getFloatProperty(runtime, options, "freeLetterCost", 2.0f);
+            readOptions.first_choices = getIntProperty(runtime, options, "firstChoices", 3);
+            readOptions.margin = getFloatProperty(runtime, options, "margin", 0.0f);
+
+            auto holder = g_whisperContexts.get(contextId);
+            if (!holder) {
+                throw jsi::JSError(runtime, "Context not found");
+            }
+            if (!holder->beginExclusiveOperation(-1)) {
+                throw jsi::JSError(runtime, "Context is already transcribing");
+            }
+
+            holder->retainTask();
+            try {
+                return createPromiseTask(runtime, callInvoker, [holder, texts, readOptions, audio]() -> PromiseResultGenerator {
+                    PromiseScopeGuard taskGuard([holder]() { holder->releaseTask(); });
+                    PromiseScopeGuard exclusiveGuard([holder]() { holder->endExclusiveOperation(); });
+
+                    std::vector<std::shared_ptr<const quran_decoding::Index>> indexes;
+                    for (const auto &text : texts) {
+                        auto index = quran_decoding::build_index(text);
+                        if (index == nullptr) {
+                            throw std::runtime_error("A held text holds no verse");
+                        }
+                        indexes.push_back(index);
+                    }
+                    auto readings = quran_decoding::read_held_to(
+                        holder->context, audio.data(), static_cast<int>(audio.size()), indexes, readOptions);
+                    if (readings.size() != indexes.size()) {
+                        throw std::runtime_error("Whisper could not read the audio again");
+                    }
+                    std::string json = quran_decoding::readings_json(readings);
+                    return [json](jsi::Runtime &rt) {
+                        return jsi::String::createFromUtf8(rt, json);
+                    };
+                }, contextId);
+            } catch (...) {
+                holder->endExclusiveOperation();
+                holder->releaseTask();
+                throw;
+            }
+        });
+
