{
  "expo": {
    "name": "Jannatuk",
    "slug": "quran-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quranapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.omazi.quran",
      "supportsTablet": false,
      "infoPlist": {
        "RCTAsyncStorageExcludeFromBackup": false,
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Jannatuk écoute ta récitation pour retrouver le passage et suivre ta lecture. Ta voix reste sur ton téléphone : rien n’est enregistré ni envoyé."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B3C44",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.omazi.quran",
      "allowBackup": true,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "fr": "./assets/app-metadata/fr.json",
      "en": "./assets/app-metadata/en.json",
      "ar": "./assets/app-metadata/ar.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3C44",
          "dark": {
            "backgroundColor": "#072C33"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": ["fr", "en", "ar"]
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "icon": "./assets/images/notification-icon.png",
          "color": "#1F5C45"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Jannatuk utilise l’appareil photo pour scanner le QR code d’invitation d’un proche. Aucune image n’est enregistrée.",
          "recordAudioAndroid": false
        }
      ],
      "./modules/voice-capture/app.plugin.js"
    ],
    "extra": {
      "supabase": {
        "url": "https://onjjwtegzeuajkcnzyvj.supabase.co",
        "publishableKey": "sb_publishable_87Wj0K4pkFvMj9sF_l7dTw_YQqlQYfP"
      },
      "features": {
        "accountInvitation": false,
        "friendsSignIn": false
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
